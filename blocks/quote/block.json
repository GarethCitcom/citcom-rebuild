{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "citcom/quote",
	"title": "Quote",
	"description": "Full-width testimonial on the persian gradient with a source line.",
	"category": "citcom",
	"icon": "format-quote",
	"keywords": [ "quote", "testimonial", "review" ],
	"textdomain": "citcom",
	"supports": {
		"anchor": true,
		"align": false,
		"html": false,
		"mode": true,
		"customClassName": true
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"postTypes": [ "page", "service", "case-study", "landing-page", "template" ],
		"usePostMeta": false
	},
	"example": {
		"attributes": {
			"mode": "preview",
			"data": {
				"quote": "<p><i>Citcom are always great to work with.</i></p>",
				"source": "A happy client"
			}
		}
	}
}
