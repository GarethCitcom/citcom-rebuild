{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "citcom/shortcode",
	"title": "Shortcode",
	"description": "A shortcode inside the standard section, with optional text before and after.",
	"category": "citcom",
	"icon": "shortcode",
	"keywords": [ "shortcode", "embed", "form", "plugin" ],
	"textdomain": "citcom",
	"supports": {
		"anchor": true,
		"align": false,
		"html": false,
		"mode": true,
		"customClassName": true
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"postTypes": [ "page", "service", "case-study", "landing-page", "template" ],
		"usePostMeta": false
	}
}
