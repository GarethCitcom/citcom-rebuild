{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "citcom/google-reviews",
	"title": "Google Reviews",
	"description": "The Elfsight Google reviews widget inside the standard section.",
	"category": "citcom",
	"icon": "star-filled",
	"keywords": [ "reviews", "google", "testimonials", "elfsight" ],
	"textdomain": "citcom",
	"supports": {
		"anchor": true,
		"align": false,
		"html": false,
		"mode": true,
		"customClassName": true
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"postTypes": [ "page", "service", "case-study", "landing-page", "template" ],
		"usePostMeta": false
	}
}
