{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "citcom/sub-services",
	"title": "Sub Services",
	"description": "Sticky pill navigation and a row per chosen service with its gallery, excerpt and links. For core service pages.",
	"category": "citcom",
	"icon": "list-view",
	"keywords": [ "services", "sub services", "navigation" ],
	"textdomain": "citcom",
	"supports": {
		"anchor": true,
		"align": false,
		"html": false,
		"mode": true,
		"customClassName": true
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3,
		"postTypes": [ "page", "service", "case-study", "landing-page", "template" ],
		"usePostMeta": false
	},
	"style": "file:../../build/blocks/sub-services/style.css"
}
